PORT=3000
# For local replica set or Atlas cluster (multi-document transactions are required)
# Local single-node replica set: mongodb://127.0.0.1:27017/?replicaSet=rs0
# Atlas cluster: mongodb+srv://<user>:<password>@cluster0.mongodb.net/art_studio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=art_studio

SESSION_SECRET=replace-with-at-least-32-random-characters-secret
APP_ORIGIN=http://localhost:5173
SERVER_ORIGIN=http://localhost:3000

# Proxy Trust Configuration
# Set to 'false' (default) when directly exposed or in local dev to prevent X-Forwarded-For spoofing.
# Set to '1' (or true/proxy IP) when behind a reverse proxy (e.g. Nginx, Cloudflare, AWS ALB, Render, Heroku).
TRUST_PROXY=false

# Google OAuth 2.0 Credentials
# Local callback URL: http://localhost:3000/api/auth/google/callback
# Add production callback URL to Google Cloud Console before deploying.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

STUDIO_EMAIL=studio@artstudio.com
STUDIO_PASSWORD=replace-with-a-strong-studio-password-min-12-chars
